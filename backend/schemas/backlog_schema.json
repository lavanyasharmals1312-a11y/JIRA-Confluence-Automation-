{
    "type": "object",
    "required": [
        "project_name",
        "project_description",
        "epics"
    ],
    "properties": {
        "project_name": {
            "type": "string"
        },
        "project_description": {
            "type": "string"
        },
        "epics": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "business_objective",
                    "business_value",
                    "description",
                    "scope",
                    "out_of_scope",
                    "assumptions",
                    "dependencies",
                    "risks",
                    "acceptance_criteria",
                    "stories"
                ],
                "properties": {

                    "title": {
                        "type": "string"
                    },

                    "business_objective": {
                        "type": "string"
                    },

                    "business_value": {
                        "type": "string"
                    },

                    "description": {
                        "type": "string"
                    },

                    "scope": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "out_of_scope": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "assumptions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "dependencies": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "risks": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "acceptance_criteria": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },

                    "stories": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": [
                                "title",
                                "description",
                                "as_a",
                                "i_want",
                                "so_that",
                                "priority",
                                "story_points",
                                "acceptance_criteria",
                                "tasks"
                            ],
                            "properties": {

                                "title": {
                                    "type": "string"
                                },

                                "description": {
                                    "type": "string"
                                },

                                "as_a": {
                                    "type": "string"
                                },

                                "i_want": {
                                    "type": "string"
                                },

                                "so_that": {
                                    "type": "string"
                                },

                                "priority": {
                                    "type": "string",
                                    "enum": [
                                        "High",
                                        "Medium",
                                        "Low"
                                    ]
                                },

                                "story_points": {
                                    "type": "integer",
                                    "enum": [
                                        1,
                                        2,
                                        3,
                                        5,
                                        8,
                                        13
                                    ]
                                },

                                "acceptance_criteria": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },

                                "tasks": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "title",
                                            "description",
                                            "definition_of_done"
                                        ],
                                        "properties": {

                                            "title": {
                                                "type": "string"
                                            },

                                            "description": {
                                                "type": "string"
                                            },

                                            "definition_of_done": {
                                                "type": "string"
                                            }

                                        }
                                    }
                                }

                            }
                        }
                    }

                }
            }
        }
    }
}